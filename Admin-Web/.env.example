# Browser API path, forwarded by the Next.js API route.
NEXT_PUBLIC_API_URL=/api/v1

# Backend origin. The proxy appends /api/v1 to this URL.
FIELDOPS_API_URL=http://localhost:8080

# Optional full API base URL; takes precedence over FIELDOPS_API_URL.
# FIELDOPS_API_INTERNAL_URL=http://localhost:8080/api/v1
